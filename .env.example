# Copiar como .env (en el hosting, cargar estas variables en el panel de la app Node).

NODE_ENV=production
PORT=3000

# Base de datos MySQL (la misma del sistema PHP, o una copia para probar).
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_de_base
DB_PASS=contrasena_de_base
DB_NAME=nombre_de_base

# Clave para firmar la cookie de sesión. Mínimo 32 caracteres, aleatoria.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Duración de la sesión sin actividad, en horas, según el rol.
SESSION_HORAS_VIGILADOR=12
SESSION_HORAS_SUPERVISOR=12
SESSION_HORAS_BACKOFFICE=8

# true = la cookie solo viaja por HTTPS (por defecto true en producción).
# En una prueba local sin HTTPS poner false.
# COOKIE_SECURE=false
